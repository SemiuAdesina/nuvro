NUVRO_ENV=development
NUVRO_HTTP_PORT=8080
NUVRO_TRUSTED_PROXY_HOPS=0
NUVRO_TRUSTED_PROXY_CIDRS=
NUVRO_RETENTION_INTERVAL=6h
NUVRO_APPLE_TEAM_ID=
NUVRO_HTTP_READ_HEADER_TIMEOUT=5s
NUVRO_HTTP_READ_TIMEOUT=15s
NUVRO_HTTP_WRITE_TIMEOUT=30s
NUVRO_HTTP_IDLE_TIMEOUT=120s
NUVRO_HTTP_MAX_HEADER_BYTES=1048576
NUVRO_HTTP_SHUTDOWN_TIMEOUT=20s
NUVRO_LOG_LEVEL=info

NUVRO_DATABASE_URL=postgres://nuvro:nuvro@localhost:5432/nuvro?sslmode=disable
NUVRO_REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
GOOGLE_WEATHER_API_KEY=

NUVRO_APPLE_AUDIENCE=
NUVRO_APPLE_ISSUER=https://appleid.apple.com
NUVRO_APPLE_KEY_ENDPOINT=https://appleid.apple.com/auth/keys
NUVRO_APPLE_KEY_TTL=1h
NUVRO_CURSOR_SECRET=
NUVRO_SESSION_SIGNING_KEY=

NUVRO_DEV_AUTH_CREDENTIAL=
NUVRO_DEV_AUTH_SUBJECT=local-traveller

NUVRO_TEST_DATABASE_URL=
NUVRO_TEST_REDIS_URL=

# Live travel data providers. Leave unset and every engine reports honest unknown evidence.
# Server side only; never ship a provider key to a mobile client.
GOOGLE_MAPS_API_KEY=
NUVRO_PROVIDER_TIMEOUT=5s
NUVRO_REFERENCE_CURRENCY=USD
NUVRO_APPLE_KEY_ID=
NUVRO_APPLE_PRIVATE_KEY=
NUVRO_TOKEN_SEALING_KEY=
